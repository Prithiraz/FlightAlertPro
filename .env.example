# FlightAlertPro – backend environment variables
# IMPORTANT: The real .env file for the backend should be placed ONE DIRECTORY ABOVE the repo root
# (i.e. at ../FlightAlertPro/../.env relative to the project directory, or wherever config.py points).
# Copy this file there and fill in real values. NEVER commit real secrets.

# ── Supabase ──────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=REDACTED_SUPABASE_ANON_KEY
SUPABASE_SERVICE_KEY=REDACTED_SUPABASE_SERVICE_ROLE_KEY

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=REDACTED_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=REDACTED_STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_KEY=REDACTED_STRIPE_WEBHOOK_SECRET
PRO_PLAN_PRICE_ID=price_REDACTED_PRO
ELITE_PLAN_PRICE_ID=price_REDACTED_ELITE
BUSINESS_PLAN_PRICE_ID=price_REDACTED_BUSINESS

# ── Flight Data Providers ─────────────────────────────────────────────────────
# CheckWX free-tier API key (https://www.checkwx.com/) — used for METAR / density altitude
CHECKWX_API_KEY=REDACTED_CHECKWX_API_KEY
RAPIDAPI_KEY=REDACTED_RAPIDAPI_KEY
RAPIDAPI_HOST=sky-scrapper.p.rapidapi.com
FLIGHTAPI_KEY=REDACTED_FLIGHTAPI_KEY
# DUFFEL_API_KEY is the variable name used internally by the backend (config.py / duffel_service.py).
# DUFFEL_ACCESS_TOKEN is the token name used in the Duffel dashboard. Set both to the same value.
DUFFEL_API_KEY=duffel_REDACTED
DUFFEL_ACCESS_TOKEN=duffel_REDACTED
AMADEUS_CLIENT_ID=REDACTED_AMADEUS_CLIENT_ID
AMADEUS_CLIENT_SECRET=REDACTED_AMADEUS_CLIENT_SECRET
FLIGHT_API_KEY=REDACTED_SERPAPI_KEY

# ── Notifications ─────────────────────────────────────────────────────────────
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=REDACTED_GMAIL_APP_PASSWORD
TELEGRAM_BOT_TOKEN=REDACTED_TELEGRAM_BOT_TOKEN
YCLOUD_API_KEY=REDACTED_YCLOUD_API_KEY
WABA_ACCESS_TOKEN=REDACTED_WABA_ACCESS_TOKEN
WABA_BUSINESS_ID=REDACTED_WABA_BUSINESS_ID
WABA_PHONE_NUMBER_ID=REDACTED_WABA_PHONE_NUMBER_ID

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-REDACTED

# ── App Config ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
REDIS_URL=redis://localhost:6379
SENTRY_DSN=

# Comma-separated list of frontend origins allowed to call the API.
# Leave empty in development (all origins allowed). Set in production, e.g.:
#   ALLOWED_ORIGINS=https://flightalertpro.vercel.app,https://www.flightalertpro.com
ALLOWED_ORIGINS=

# ── Ancillary Revenue / Hotel Affiliate ──────────────────────────────────────
HOTEL_AFFILIATE_BASE_URL=https://www.booking.com/searchresults.html
HOTEL_AFFILIATE_ID=YOUR_BOOKING_COM_AFFILIATE_ID
VITE_HOTEL_AFFILIATE_BASE_URL=https://www.booking.com/searchresults.html
VITE_HOTEL_AFFILIATE_ID=YOUR_BOOKING_COM_AFFILIATE_ID

# ── System Check (optional) ───────────────────────────────────────────────────
# Set to a test email to enable the live DB alert check in /api/systemcheck
SYSTEMCHECK_TEST_USER=
