# FlightAlertPro – backend environment variables
# IMPORTANT: The real .env file for the backend should be placed ONE DIRECTORY ABOVE the repo root
# (i.e. at ../FlightAlertPro/../.env relative to the project directory, or wherever config.py points).
# Copy this file there and fill in real values. NEVER commit real secrets.

# ── Supabase ──────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=REDACTED_SUPABASE_ANON_KEY
# JWT secret from Supabase Dashboard → Settings → API → JWT Secret
SUPABASE_JWT_SECRET=REDACTED_SUPABASE_JWT_SECRET

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=REDACTED_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=REDACTED_STRIPE_PUBLISHABLE_KEY
STRIPE_WEBHOOK_KEY=REDACTED_STRIPE_WEBHOOK_SECRET
PRO_PLAN_PRICE_ID=price_REDACTED_PRO
ELITE_PLAN_PRICE_ID=price_REDACTED_ELITE
BUSINESS_PLAN_PRICE_ID=price_REDACTED_BUSINESS

# ── Flight Data Providers ─────────────────────────────────────────────────────
RAPIDAPI_KEY=REDACTED_RAPIDAPI_KEY
FLIGHTAPI_KEY=REDACTED_FLIGHTAPI_KEY
DUFFEL_API_KEY=duffel_REDACTED

# ── Notifications ─────────────────────────────────────────────────────────────
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=REDACTED_GMAIL_APP_PASSWORD
TELEGRAM_BOT_TOKEN=REDACTED_TELEGRAM_BOT_TOKEN
YCLOUD_API_KEY=REDACTED_YCLOUD_API_KEY
WABA_ACCESS_TOKEN=REDACTED_WABA_ACCESS_TOKEN
WABA_BUSINESS_ID=REDACTED_WABA_BUSINESS_ID
WABA_PHONE_NUMBER_ID=REDACTED_WABA_PHONE_NUMBER_ID

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-REDACTED

# ── App Config ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
REDIS_URL=redis://localhost:6379
SENTRY_DSN=
# Comma-separated list of allowed CORS origins (no wildcards — credentials require explicit origins).
# Use FRONTEND_ORIGINS in staging/production; ALLOWED_ORIGINS is a legacy alias.
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000
# Maximum number of active alerts a single user can hold (anti-abuse)
MAX_ALERTS_PER_USER=10

# ── Kill Switches ─────────────────────────────────────────────────────────────
# Set to 'true' to instantly disable the corresponding feature
DISABLE_SEARCH=false
DISABLE_NOTIFICATIONS=false
DISABLE_BILLING=false
DISABLE_PROVIDER_DUFFEL=false

# ── System Check (optional) ───────────────────────────────────────────────────
# Set to a test email to enable the live DB alert check in /api/systemcheck
SYSTEMCHECK_TEST_USER=

# ── Web Push / PWA (optional) ─────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
# The public key must also be set as VITE_VAPID_PUBLIC_KEY in frontend/.env
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact email for VAPID claims (defaults to user email if not set)
VAPID_CONTACT_EMAIL=you@example.com
# Frontend: copy the public key here so the browser can subscribe
VITE_VAPID_PUBLIC_KEY=
